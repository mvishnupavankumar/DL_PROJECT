# AegisOps Configuration

# LLM Agent Configuration (Optional)
# If empty or not set, agents run in deterministic offline mode
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MAX_RETRIES=2

# Live Monitoring Service Configuration
# Default target is local test service bound to 127.0.0.1:8765
AEGISOPS_SERVICE_URL=http://127.0.0.1:8765
AEGISOPS_PROBE_PATH=/probe
AEGISOPS_REQUEST_TIMEOUT_S=3.0
AEGISOPS_VERIFY_TLS=true
AEGISOPS_BEARER_TOKEN=

# Collector Worker Configuration
AEGISOPS_LOG_LEVEL=INFO
AEGISOPS_COLLECTION_INTERVAL_S=5

# Live LSTM inference controls
# Unset checkpoint path selects only models/live_lstm_autoencoder.pt.
# The frozen synthetic checkpoint is permitted solely for an explicit integration smoke test.
AEGISOPS_LSTM_CHECKPOINT_PATH=
AEGISOPS_ENABLE_FROZEN_SMOKE_TEST=false
# Required before LSTM scoring. Set an owner-approved positive limit in seconds; no default is applied.
AEGISOPS_LSTM_MAX_INTER_SAMPLE_GAP_S=
